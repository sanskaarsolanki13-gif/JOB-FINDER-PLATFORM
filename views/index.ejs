<!DOCTYPE html>
<html lang="en" class="bg-gray-100">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Job Portal</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="flex items-center justify-center h-screen">
<div class="bg-white shadow-xl rounded-xl p-10 space-y-6 w-[350px]">
    <h1 class="text-2xl font-bold text-center text-blue-600">Welcome to Job Portal</h1>

    <div class="space-y-4">
        <h2 class="text-lg font-semibold text-gray-700">User Section</h2>
        <a href="/user/register" class="block bg-blue-500 hover:bg-blue-600 text-white py-2 px-4 rounded text-center">Register as User</a>
        <a href="/user/login" class="block bg-blue-500 hover:bg-blue-600 text-white py-2 px-4 rounded text-center">Login as User</a>
    </div>

    <div class="space-y-4">
        <h2 class="text-lg font-semibold text-gray-700">Recruiter Section</h2>
        <a href="/recruiter/register" class="block bg-green-500 hover:bg-green-600 text-white py-2 px-4 rounded text-center">Register as Recruiter</a>
        <a href="/recruiter/login" class="block bg-green-500 hover:bg-green-600 text-white py-2 px-4 rounded text-center">Login as Recruiter</a>
    </div>
</div>
</body>
</html>
