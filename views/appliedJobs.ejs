<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Applied Jobs</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-100 p-8">
<h1 class="text-3xl font-bold mb-6 text-center text-gray-800">Jobs You've Applied To</h1>

<div class="grid gap-6 max-w-3xl mx-auto">
    <% jobs.forEach(job => { %>
        <div class="bg-white shadow-md rounded-lg p-6">
            <h2 class="text-xl font-semibold mb-2"><%= job.title %></h2>
            <p class="text-gray-700 mb-1"><%= job.description %></p>
            <p class="text-sm text-gray-500">Status: Applied ✅</p>
        </div>
    <% }) %>
</div>
</body>
</html>
