<!DOCTYPE html>
<html>
<head>
    <title>Applicants</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-100 p-6">
<div class="max-w-2xl mx-auto">
    <h1 class="text-3xl font-bold mb-6 text-center text-gray-800">Applicants for <%= job.title %></h1>
    <ul class="space-y-4">
        <% job.applicants.forEach(app => { %>
            <li class="bg-white p-5 rounded-2xl shadow border border-gray-200">
                <% if (app.user) { %>
                    <p class="mb-1"><span class="font-semibold">Name:</span> <%= app.user.name %></p>
                    <p class="mb-1"><span class="font-semibold">Email:</span> <%= app.user.email %></p>
                <% } else { %>
                    <p class="text-red-500">User information not available.</p>
                <% } %>

                <% if (app.resume) { %>
                    <p class="mb-1"><span class="font-semibold">Resume:</span>
                        <a href="http://localhost:3000<%= app.resume %>" class="text-blue-600 underline" target="_blank">
                            View Resume
                        </a>
                    </p>
                <% } else { %>
                    <p class="text-gray-500">No resume uploaded.</p>
                <% } %>
            </li>
        <% }) %>
    </ul>
</div>
</body>
</html>
