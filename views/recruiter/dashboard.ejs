<!DOCTYPE html>
<html>
<head>
    <title>Recruiter Dashboard</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-100 p-6">
<div class="max-w-3xl mx-auto">
    <h1 class="text-3xl font-bold text-green-700 mb-4">Welcome, <%= recruiter.email %></h1>
    <a href="/recruiter/postJob" class="inline-block mb-4 bg-blue-600 text-white py-2 px-4 rounded hover:bg-blue-700">Post a Job</a>

    <h2 class="text-xl font-semibold text-gray-700 mb-2">Your Jobs</h2>
    <ul class="space-y-4">
        <% jobs.forEach(job => { %>
            <li class="bg-white p-4 rounded shadow">
                <h3 class="font-bold text-lg"><%= job.title %></h3>
                <p><%= job.description %></p>
                <p class="text-sm text-gray-500">Location: <%= job.location %>, Salary: ₹<%= job.salary %></p>
                <a href="/recruiter/job/<%= job._id %>/applicants" class="text-blue-600 underline">View Applicants</a>
            </li>
        <% }) %>
    </ul>
</div>
</body>
</html>
